---
import { NAV, SITE, CTA } from '../config';
import { url } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  return href === '/' ? path === target : path.startsWith(target);
};
---

<header class="sticky top-0 z-50 border-b border-brand-ink/10 bg-white/85 backdrop-blur">
  <nav class="container-px flex h-16 items-center justify-between gap-4" aria-label="Navigation principale">
    <a href={url('/')} class="flex shrink-0 items-center gap-2.5">
      <img src={url('/images/logo-endurall-detoure.png')} alt="" width="40" height="40" class="h-10 w-10" />
      <span class="font-display text-lg font-extrabold tracking-tight">{SITE.name}</span>
    </a>

    <!-- Liens desktop -->
    <ul class="hidden items-center gap-0.5 md:flex">
      {NAV.map((item) => (
        <li>
          <a
            href={url(item.href)}
            class:list={[
              'whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-brand-violet'
                : 'text-brand-ink/70 hover:text-brand-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href={url(CTA.href)} class="btn-primary hidden whitespace-nowrap md:inline-flex">{CTA.label}</a>

      <!-- Bouton menu mobile -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-brand-ink md:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </nav>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-brand-ink/10 bg-white md:hidden">
    <ul class="container-px flex flex-col py-3">
      {NAV.map((item) => (
        <li>
          <a
            href={url(item.href)}
            class:list={[
              'block rounded-lg px-3 py-3 text-base font-medium',
              isActive(item.href) ? 'text-brand-violet' : 'text-brand-ink/80',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="px-3 pb-2 pt-3"><a href={url(CTA.href)} class="btn-primary w-full py-3.5 text-base">{CTA.label}</a></li>
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const open = document.getElementById('icon-open');
    const close = document.getElementById('icon-close');
    if (!btn || !menu) return;
    const setOpen = (value) => {
      btn.setAttribute('aria-expanded', String(value));
      btn.setAttribute('aria-label', value ? 'Fermer le menu' : 'Ouvrir le menu');
      menu.classList.toggle('hidden', !value);
      open?.classList.toggle('hidden', value);
      close?.classList.toggle('hidden', !value);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    // Ferme le menu quand on clique sur un lien (ex. ancre #contact sur la même page)
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  })();
</script>
