---
// Bandeau d'avis Google de la page d'accueil.
// Les avis sont recopiés à la main depuis la fiche Google (src/content/accueil/contenu.yml).
import Txt from './Txt.astro';
import { estRenseigne } from '../lib/site';

interface Props {
  note: string;
  lien: string;
  avis: { auteur: string; note: number; texte: string }[];
}

const { note, lien, avis } = Astro.props;
const etoiles = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
---

<section class="border-y border-brand-ink/10 bg-white py-10 md:py-14" aria-labelledby="avis-titre">
  <div class="container-px">
    <div class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left" data-reveal>
      <div class="flex items-center gap-3">
        <span class="text-2xl tracking-wider text-brand-orange" aria-hidden="true">★★★★★</span>
        <h2 id="avis-titre" class="text-lg font-bold">
          {estRenseigne(note) ? <>{note}/5 sur Google</> : <>Avis Google · <Txt value={note} /></>}
        </h2>
      </div>
      {estRenseigne(lien) ? (
        <a href={lien} target="_blank" rel="noopener" class="btn-outline">Voir tous les avis</a>
      ) : (
        <span class="text-sm text-brand-ink/60">Lien vers la fiche Google : <span class="a-completer">[À COMPLÉTER]</span></span>
      )}
    </div>

    {avis.length > 0 ? (
      <ul class="-mx-5 mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 sm:mx-0 sm:px-0 md:grid md:grid-cols-3 md:overflow-visible" data-reveal>
        {avis.map((a) => (
          <li class="card w-[85%] shrink-0 snap-start sm:w-[60%] md:w-auto">
            <p class="text-brand-orange" aria-label={`${a.note} étoiles sur 5`}>{etoiles(a.note)}</p>
            <p class="mt-3 text-sm text-brand-ink/80">« <Txt value={a.texte} /> »</p>
            <p class="mt-4 text-sm font-semibold">{a.auteur}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 text-center text-sm text-brand-ink/60" data-reveal>
        <span class="a-completer">[À COMPLÉTER]</span> Recopier ici les avis de la fiche Google.
      </p>
    )}
  </div>
</section>
